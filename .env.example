# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=your_key_here
WHISPER_MODEL=whisper-1
GPT_PARSE_MODEL=gpt-4o-mini
GPT_INSIGHTS_MODEL=gpt-4o

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=your_key_here
STRIPE_PUBLISHABLE_KEY=your_key_here
STRIPE_WEBHOOK_SECRET=your_key_here
STRIPE_PRICE_1_WEEK=price_xxx
STRIPE_PRICE_1_MONTH=price_xxx
STRIPE_PRICE_3_MONTHS=price_xxx
STRIPE_PRICE_6_MONTHS=price_xxx
STRIPE_PRICE_1_YEAR=price_xxx

# ── Click (click.uz) ──────────────────────────────────────
CLICK_SERVICE_ID=your_service_id_here
CLICK_MERCHANT_ID=your_merchant_id_here
CLICK_SECRET_KEY=your_secret_key_here

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bugalter_user:secure_password@localhost:5432/ai_bugalter
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
WEBHOOK_URL=https://resumeapi.duckdns.org/webhook
WEBHOOK_SECRET=change_me_to_a_random_string

# ── Free tier ─────────────────────────────────────────────
FREE_TIER_MONTHLY_LIMIT=5

# ── Monitoring (optional) ────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
